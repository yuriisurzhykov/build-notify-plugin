# Shared formatting for ide-plugin and mobile-app.
# ktlint reads this file; IntelliJ / Android Studio apply the same settings.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# JetBrains Kotlin coding conventions (the IntelliJ IDEA formatter defaults).
ktlint_code_style = intellij_idea
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, ^
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

# House style: arrows of `when` branches are aligned in a column.
ktlint_standard_no-multi-spaces = disabled

# One owner per concern: naming is checked by detekt (configured for Compose, where
# @Composable functions and design tokens are PascalCase), formatting by ktlint.
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
