-- v1 -> v2: line counters, backfilled from the lines already cached.
CREATE TABLE build_log_count (
    build_id        TEXT NOT NULL REFERENCES active_build(build_id) ON DELETE CASCADE,
    kind            TEXT NOT NULL,
    line_count      INTEGER NOT NULL,
    first_timestamp INTEGER NOT NULL,
    PRIMARY KEY (build_id, kind)
);

INSERT INTO build_log_count (build_id, kind, line_count, first_timestamp)
SELECT build_id, kind, COUNT(*), MIN(timestamp)
FROM build_log
GROUP BY build_id, kind;
